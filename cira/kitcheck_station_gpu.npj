{
    "scene_array": [
        {
            "data": "{\n    \"connections\": [\n        {\n            \"in_id\": \"{69bfee2a-f84e-42aa-be87-92e2c0ca409c}\",\n            \"in_index\": 0,\n            \"out_id\": \"{23027051-79dc-4158-8420-ecf6efadd1ea}\",\n            \"out_index\": 0\n        },\n        {\n            \"in_id\": \"{7396bbdd-f0ec-4f24-a3af-ef60daa6ee12}\",\n            \"in_index\": 0,\n            \"out_id\": \"{69bfee2a-f84e-42aa-be87-92e2c0ca409c}\",\n            \"out_index\": 0\n        },\n        {\n            \"in_id\": \"{23027051-79dc-4158-8420-ecf6efadd1ea}\",\n            \"in_index\": 0,\n            \"out_id\": \"{7396bbdd-f0ec-4f24-a3af-ef60daa6ee12}\",\n            \"out_index\": 0\n        },\n        {\n            \"in_id\": \"{eed874c6-124c-41d0-9bc5-54d64f07e08b}\",\n            \"in_index\": 0,\n            \"out_id\": \"{7396bbdd-f0ec-4f24-a3af-ef60daa6ee12}\",\n            \"out_index\": 0\n        }\n    ],\n    \"nodes\": [\n        {\n            \"id\": \"{23027051-79dc-4158-8420-ecf6efadd1ea}\",\n            \"model\": {\n                \"name\": \"ButtonRun\"\n            },\n            \"ngo\": {\n                \"comment\": {\n                    \"data\": \"\",\n                    \"show\": false\n                }\n            },\n            \"position\": {\n                \"fix\": false,\n                \"x\": 100,\n                \"y\": 60\n            }\n        },\n        {\n            \"id\": \"{69bfee2a-f84e-42aa-be87-92e2c0ca409c}\",\n            \"model\": {\n                \"data\": {\n                    \"LaptopCamera\": {\n                        \"customPipeline\": \"! multipartdemux ! jpegdec\",\n                        \"encodeMode\": \"H265\",\n                        \"frameRate\": 10,\n                        \"timeout_s\": 10,\n                        \"url\": \"http://172.17.0.1:8083/stream\",\n                        \"useCustomPipeline\": false\n                    }\n                },\n                \"name\": \"GstCam \",\n                \"node_enable\": true,\n                \"setting\": {\n                    \"name\": \"LaptopCamera\"\n                }\n            },\n            \"ngo\": {\n                \"comment\": {\n                    \"data\": \"\",\n                    \"show\": false\n                }\n            },\n            \"position\": {\n                \"fix\": false,\n                \"x\": 100,\n                \"y\": 220\n            }\n        },\n        {\n            \"id\": \"{7396bbdd-f0ec-4f24-a3af-ef60daa6ee12}\",\n            \"model\": {\n                \"data\": {\n                    \"comment\": \"KitCheck: real-time YOLO on T4 GPU\",\n                    \"py_ver\": \"1. python3.12\",\n                    \"script\": \"# ===================== KitCheck (cloud GPU VM): real-time detection results into CiRA =====================\\n# gpu_station.py on this VM checks EVERY camera frame with YOLO11n on the T4 (10 frames/s) and sends each result\\n# to KitCheck itself. GstCam shows that video with the boxes drawn in (http://172.17.0.1:8083/stream).\\n# This node (CiRA runs it once per frame in a fresh python3.12, with payload and img) only copies the newest\\n# result into the payload, so later nodes / Debug can use it:\\n#   payload[\\\"detections\\\"] = [{\\\"type\\\",\\\"conf\\\",\\\"qr\\\",\\\"box\\\":[x,y,w,h] (0..1)}], payload[\\\"kitcheck\\\"] = status\\nimport json\\nimport time\\nimport urllib.request\\nLATEST = 'http://172.17.0.1:8090/latest'\\nSTATUS = {'last_error': ''}\\ntry:\\n\\twith urllib.request.urlopen(LATEST, timeout=2) as r:\\n\\t\\tres = json.load(r)\\n\\tpayload.update({k: res[k] for k in ('detections', 'duration', 'ts', 'image_w', 'image_h') if k in res})\\n\\tSTATUS['scan_waiting'] = bool(res.get('wanted'))\\n\\tSTATUS['age_s'] = round(time.time() - res.get('ts', 0), 2)\\n\\tSTATUS['tools'] = [d['type'] for d in res.get('detections', [])]\\nexcept Exception as e:\\n\\tSTATUS['last_error'] = repr(e)[:300]\\npayload['kitcheck'] = STATUS\\ntime.sleep(0.2)  # the flow's loop waits for this script: about 3-4 updates a second is plenty for Debug\\n# ==========================================================================================================\\n\",\n                    \"tmp_path\": \"/home/cira\",\n                    \"widget_state\": {\n                        \"editor_setting\": {\n                            \"autoComplete\": {\n                                \"caseSensitivity\": true,\n                                \"enable\": true,\n                                \"threshold\": 3\n                            },\n                            \"indent\": {\n                                \"enable\": true\n                            },\n                            \"theme\": \"Material Dark\",\n                            \"whitespace\": {\n                                \"enable\": false,\n                                \"size\": 2\n                            }\n                        },\n                        \"splt0\": 16,\n                        \"splt1\": 10\n                    }\n                },\n                \"height\": 47,\n                \"name\": \"PythonScript\",\n                \"node_enable\": true,\n                \"python_code\": \"# ===================== KitCheck (cloud GPU VM): real-time detection results into CiRA =====================\\n# gpu_station.py on this VM checks EVERY camera frame with YOLO11n on the T4 (10 frames/s) and sends each result\\n# to KitCheck itself. GstCam shows that video with the boxes drawn in (http://172.17.0.1:8083/stream).\\n# This node (CiRA runs it once per frame in a fresh python3.12, with payload and img) only copies the newest\\n# result into the payload, so later nodes / Debug can use it:\\n#   payload[\\\"detections\\\"] = [{\\\"type\\\",\\\"conf\\\",\\\"qr\\\",\\\"box\\\":[x,y,w,h] (0..1)}], payload[\\\"kitcheck\\\"] = status\\nimport json\\nimport time\\nimport urllib.request\\nLATEST = 'http://172.17.0.1:8090/latest'\\nSTATUS = {'last_error': ''}\\ntry:\\n\\twith urllib.request.urlopen(LATEST, timeout=2) as r:\\n\\t\\tres = json.load(r)\\n\\tpayload.update({k: res[k] for k in ('detections', 'duration', 'ts', 'image_w', 'image_h') if k in res})\\n\\tSTATUS['scan_waiting'] = bool(res.get('wanted'))\\n\\tSTATUS['age_s'] = round(time.time() - res.get('ts', 0), 2)\\n\\tSTATUS['tools'] = [d['type'] for d in res.get('detections', [])]\\nexcept Exception as e:\\n\\tSTATUS['last_error'] = repr(e)[:300]\\npayload['kitcheck'] = STATUS\\ntime.sleep(0.2)  # the flow's loop waits for this script: about 3-4 updates a second is plenty for Debug\\n# ==========================================================================================================\\n\",\n                \"width\": 75\n            },\n            \"ngo\": {\n                \"comment\": {\n                    \"data\": \"\",\n                    \"show\": false\n                }\n            },\n            \"position\": {\n                \"fix\": false,\n                \"x\": 380,\n                \"y\": 220\n            }\n        },\n        {\n            \"id\": \"{eed874c6-124c-41d0-9bc5-54d64f07e08b}\",\n            \"model\": {\n                \"height\": 140,\n                \"name\": \"Debug\",\n                \"output_h\": 0,\n                \"output_v\": 0,\n                \"page_index\": 0,\n                \"payload_h\": 0,\n                \"payload_v\": 0,\n                \"width\": 225\n            },\n            \"ngo\": {\n                \"comment\": {\n                    \"data\": \"\",\n                    \"show\": false\n                }\n            },\n            \"position\": {\n                \"fix\": false,\n                \"x\": 660,\n                \"y\": 60\n            }\n        }\n    ],\n    \"scene_data\": {\n        \"flow_view_fix\": false,\n        \"flow_view_pos_x\": -60,\n        \"flow_view_pos_y\": -20,\n        \"flow_view_zoom_factor\": 0.8,\n        \"scene_version\": 1\n    }\n}\n",
            "name": "Main"
        }
