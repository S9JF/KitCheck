# Copy to local.env and fill in. local.env is in .gitignore: never commit it.

# MQTT broker (Mosquitto)
KITCHECK_MQTT_USER=
KITCHECK_MQTT_PASS=
# KITCHECK_MQTT_HOST=127.0.0.1

# AI station IPs allowed to post results without login (comma-separated, e.g. the GPU VM's Tailscale IP)
KITCHECK_STATION_IPS=

# KITCHECK_PORT=8080
# KITCHECK_LOCAL_CAMERA=0
# KITCHECK_LOCAL_CAMERA_SIZE=1280x720
# KITCHECK_LOCAL_CAMERA_FPS=30

# 1 = virtual tray + scale from the /sim page (demo without hardware); remove for the real camera and scale
KITCHECK_VIRTUAL=1

# Network camera (go2rtc / ustreamer)
KITCHECK_CAMERA_URL=
KITCHECK_CAMERA_PASS=
KITCHECK_CAMERA_SNAPSHOT_PATH=stream
KITCHECK_CAMERA_KEEPALIVE=1
KITCHECK_CAMERA_STREAM_PATH=/api/stream.mjpeg?src=cam
